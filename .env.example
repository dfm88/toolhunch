# Copy to .env and fill in. Unit tests never need these; only live adapters and the benchmark do.

# TypeSafe Jev (System-1 decision model) — https://docs.typesafe.ai
TYPESAFE_API_KEY=

# OpenAI: embeddings, logprob-based decision baseline, end-to-end agent runs
OPENAI_API_KEY=

# Optional: Anthropic native tool search path in the end-to-end benchmark
ANTHROPIC_API_KEY=

# Optional: Jev and other models through OpenRouter
OPENROUTER_API_KEY=
